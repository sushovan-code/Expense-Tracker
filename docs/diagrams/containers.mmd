%% Container view. Claude rewrites this from the code via /update-diagrams.
%% Accent (#2563EB) marks this system's own containers; grey is everything else.
flowchart LR
  classDef ours fill:#DBEAFE,stroke:#2563EB,color:#0F172A
  classDef ext fill:#F1F5F9,stroke:#94A3B8,color:#334155,stroke-dasharray:4 3

  user([Family member])
  web[Web app<br/><small>React + TypeScript SPA, Vite</small>]:::ours
  api[API<br/><small>.NET 10 Minimal API, SignalR hub,<br/>ASP.NET Core Identity + JWT</small>]:::ours
  cache[(HybridCache<br/><small>in-memory, user access snapshots</small>)]:::ours
  db[(SQLite file<br/><small>EF Core: expenses, categories,<br/>users, roles, sessions, API keys</small>)]:::ours
  dashboard[Aspire dashboard<br/><small>development only</small>]:::ext

  user --> web
  web -->|HTTPS, JSON, bearer token| api
  api -. SignalR: changes, budget alerts .-> web
  api --> cache
  api -->|EF Core| db
  api -. OTLP .-> dashboard
  web -. OTLP over HTTP .-> dashboard

  subgraph Legend
    direction LR
    l1[This system]:::ours
    l2[External]:::ext
  end
