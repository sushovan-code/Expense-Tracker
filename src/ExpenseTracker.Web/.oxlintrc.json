{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "typescript",
    "oxc",
    "import"
  ],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ],
    "import/no-cycle": "error",
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": [
              "@/features/*/**"
            ],
            "message": "Import another feature only through its public API: '@/features/<name>'."
          },
          {
            "group": [
              "@/app",
              "@/app/*"
            ],
            "message": "Only the app layer (composition root) may import from src/app."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "src/shared/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@/features",
                  "@/features/*",
                  "@/app",
                  "@/app/*"
                ],
                "message": "shared/ is the bottom layer: it must not depend on features or the app."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/main.tsx",
        "src/app/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@/features/*/**"
                ],
                "message": "Import a feature only through its public API: '@/features/<name>'."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/test/**",
        "src/**/*.test.tsx"
      ],
      "rules": {
        "react/only-export-components": "off"
      }
    }
  ]
}
