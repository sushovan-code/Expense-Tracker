# Shared by every mode. Mode files (.env.development, .env.staging, .env.production) override these.
# Put machine-specific overrides in .env.local or .env.<mode>.local (git-ignored).
#
# Only variables prefixed with VITE_ are exposed to browser code; everything else is
# read by vite.config.ts only.

# Base URL the browser uses for API calls. Relative (/api) means "same origin": the
# Vite dev/preview server proxies it to API_PROXY_TARGET. Use an absolute URL when the
# deployed client and API live on different domains (the API must then allow the
# client's origin under Cors:AllowedOrigins).
VITE_API_BASE_URL=/api
