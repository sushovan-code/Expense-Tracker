{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=App_Data/expense-tracker.db"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5010" ]
  },
  "Features": {
    "ApiDocs": true,
    "MigrateDatabaseOnStartup": true
  },
  "Authentication": {
    "Jwt": {
      "SigningKey": "dev-only-signing-key--not-a-secret--replace-outside-development"
    }
  },
  "Identity": {
    "Seed": {
      "AdminEmail": "superadmin@expensetracker.local",
      "AdminPassword": "SuperAdmin123",
      "DemoUsers": true,
      "DemoPassword": "Password123"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "ExpenseTracker": "Debug"
    }
  }
}