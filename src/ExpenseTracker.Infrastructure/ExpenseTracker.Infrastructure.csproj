<Project Sdk="Microsoft.NET.Sdk">
  <!-- Adapters for the Application ports: EF Core / SQLite persistence, read-side queries and the
       ASP.NET Core Identity store (users, roles, claims, refresh tokens, API keys). Identity's core and
       EF stores have no dependency on the HTTP pipeline. -->
  <ItemGroup>
    <ProjectReference Include="..\ExpenseTracker.Application\ExpenseTracker.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.Extensions.Caching.Hybrid" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ExpenseTracker.Api.IntegrationTests" />
  </ItemGroup>
</Project>
