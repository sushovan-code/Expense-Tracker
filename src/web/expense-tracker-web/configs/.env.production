# Pairs with the API's "Production" environment
#   server: dotnet run --launch-profile production -> configs/appsettings.Production.json
#   client: npm run build && npm run preview
# No VITE_ENV_LABEL: the environment badge is hidden in production.

# Port used by `vite preview` to serve the production build locally.
CLIENT_PORT=5030
API_PROXY_TARGET=http://localhost:7030
