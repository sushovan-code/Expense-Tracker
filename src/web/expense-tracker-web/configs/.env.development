# Pairs with the API's "Development" environment
#   server: dotnet run --launch-profile http   -> configs/appsettings.Development.json
#   client: npm run dev
VITE_ENV_LABEL=Dev

# Vite dev server port. Must be listed in the API's Cors:AllowedOrigins for Development.
CLIENT_PORT=5010

# Where the dev server forwards /api (the Development launch profile URL).
API_PROXY_TARGET=http://localhost:7010
